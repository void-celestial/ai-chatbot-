# Personal AI Companion — backend configuration
# Copy to `.env` to override defaults. Do not commit `.env`.

# Backend bind address and port (localhost only by default)
APP_HOST=127.0.0.1
APP_PORT=8000

# Ollama local API. Use the IPv4 loopback literal: Ollama binds 127.0.0.1
# only, and "localhost" first tries the unreachable ::1 address and falls
# back after a ~0.25s delay on every new connection (measured).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Exact installed model tag (verify with `ollama list`)
OLLAMA_MODEL_TAG=qwen3.5:9b

# Context window (tokens) passed to the model and chat read timeout
OLLAMA_NUM_CTX=8192

# How long Ollama keeps the model resident between requests. A cold load costs
# ~12.5s here, so keeping it loaded is the cheapest latency win.
OLLAMA_KEEP_ALIVE=30m

# Send an explicit thinking flag to Ollama (true/false; omit for the model's own
# default). This app never shows or stores reasoning, but a thinking model
# generates it first: on the 9B it delayed the first visible token by ~31s.
# OLLAMA_THINK=false

# Optional reply-length cap in tokens (0 = unlimited, the default). A cap can
# cut a reply off mid-sentence, so prefer OLLAMA_REPLY_STYLE below.
OLLAMA_NUM_PREDICT=0

# Reply length policy:
#   default  - unchanged prompt
#   concise  - one short directive: answer briefly unless the question needs depth
#   adaptive - per-situation policy: 1-3 sentences for small talk, warmth for
#              distress, full detail for technical/complex questions, and the
#              user's own length request wins over all of it
# Measured on the reference machine: with `default`, a casual message cost
# 25-39 output tokens while a technical question cost 526-590 tokens (~46s at
# 11-13 tok/s). All styles are guidance only - none caps tokens or truncates a
# reply - and `adaptive` is not enabled automatically.
OLLAMA_REPLY_STYLE=default

# Background memory-extraction call timeout (seconds). Local thinking models
# can need several minutes per exchange (measured 165-400s on the reference
# machine); extraction never blocks the chat reply.
MEMORY_EXTRACTION_TIMEOUT=600

# After a new message interrupts a running background extraction, wait this
# long for the conversation to stay quiet before restarting it, so a burst of
# consecutive messages defers extraction instead of starting and killing it.
# Foreground chat is never delayed by extraction either way. 0 restarts
# immediately after the turn.
MEMORY_EXTRACTION_IDLE_DELAY=3

# SQLite location. Relative paths resolve against the repo root in a source run
# and against %LOCALAPPDATA%\MyAIAssistant in the packaged app. Absolute paths win.
DB_PATH=data/companion.db

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Voice notes (Phase 4). Audio bytes stay on disk; SQLite stores metadata only.
VOICE_NOTES_DIR=data/voice_notes
VOICE_NOTE_MAX_BYTES=26214400

# Local transcription through ffmpeg's whisper.cpp filter. The GGML model is
# NOT downloaded automatically; point this at a model you installed yourself.
# The default is the multilingual medium model (English + Hindi, 1.43 GiB).
WHISPER_MODEL_PATH=data/models/ggml-medium.bin
WHISPER_LANGUAGE=auto
# CPU by default to avoid competing with Ollama for VRAM.
WHISPER_USE_GPU=false
TRANSCRIPTION_TIMEOUT=300
FFMPEG_BIN=ffmpeg
