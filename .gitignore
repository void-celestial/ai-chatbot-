_desktop_test*/
_desktop_final/

# One-off debug script (writes backend/app.log); not part of the app or test suite
backend/test_log.py

# Stray empty Git repository left in the working tree
ai-chatbot-/

# ---------------------------------------------------------------------------
# Selective inclusions (negations must come after the excludes above)
# ---------------------------------------------------------------------------

# Local user data: DB, voice notes, whisper model, acceptance recordings, backups.
# Everything is excluded; the reusable test scripts below are the only exceptions.
data/*
!data/acceptance/
data/acceptance/*
!data/acceptance/acceptance_run.py
!data/acceptance/wer.py
!data/acceptance/fetch_audio.py
!data/acceptance/engine_timing.py
!data/acceptance/netwatch.ps1

# Benchmark scripts are kept; their databases, JSON results and logs are not.
_bench/*
!_bench/*.py
